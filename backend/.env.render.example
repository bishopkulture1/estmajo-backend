# Reference only; put real values in private Render Environment settings.
DEBUG=false
SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=https://estmajo-engineering-solutions.netlify.app
# Neon PostgreSQL URLs. Use a pooled URL for requests and direct URL for migrations.
# TLS/hostname verification is enforced. Never place URLs in a VITE_ variable.
DATABASE_URL=
DATABASE_URL_DIRECT=
NETLIFY_PROXY_SECRET=
EMAIL_BACKEND=core.email_backend.ResendEmailBackend
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
# Initial owner only. Remove password after first verified login. No default account.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
