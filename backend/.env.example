# Copy to backend/.env. Keep this file secret after filling it in.
DEBUG=false
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# Docker: /data/db.sqlite3. Local development: absolute path or omit.
SQLITE_PATH=/data/db.sqlite3
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=104857600
MAX_DOCUMENT_BYTES=20971520
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=

# Netlify only: same random secret as the Netlify runtime/build value.
# Leave blank when serving frontend and backend together through Caddy.
NETLIFY_PROXY_SECRET=

# External PostgreSQL (required for Render Free; local SQLite otherwise).
DATABASE_URL=
DATABASE_URL_DIRECT=
# Optional HTTPS notification transport: core.email_backend.ResendEmailBackend
RESEND_API_KEY=
